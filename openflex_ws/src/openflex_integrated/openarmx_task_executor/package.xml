<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarmx_task_executor</name>
  <version>0.1.0</version>
  <description>Sequential navigation, docking, perception, and manipulation task executor.</description>
  <maintainer email="openarmrobot@gmail.com">OpenArmX</maintainer>
  <license>CC-BY-NC-SA-4.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>control_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>openarmx_integrated_moveit_config</exec_depend>
  <exec_depend>openarmx_head_vision_h264</exec_depend>
  <exec_depend>openflex_grasp</exec_depend>
  <exec_depend>openflex_grasp_moveit</exec_depend>
  <exec_depend>swerve_navigation</exec_depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>openarmx_integrated_moveit_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rclpy</depend>
  <depend>tf2_ros</depend>
  <depend>trajectory_msgs</depend>
  <depend>std_srvs</depend>
  <depend>openarmx_task_msgs</depend>
  <depend>openflex_grasp_interfaces</depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
