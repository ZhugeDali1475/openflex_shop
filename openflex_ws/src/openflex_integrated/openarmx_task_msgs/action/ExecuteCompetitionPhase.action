# One referee-authorized start command runs exactly one competition phase.
uint8 PICKING=1
uint8 RESTOCKING=2
uint8 RETURN_MISPLACED=3
string run_id
uint8 phase
bool dry_run
float32 timeout_sec
---
bool success
uint16 error_code
