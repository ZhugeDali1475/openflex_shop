# Fine alignment against a station marker or local geometric feature.
string station_id
int32 marker_id
float32 position_tolerance
float32 yaw_tolerance
float32 timeout_sec
bool use_target_marker_pose
geometry_msgs/Pose target_marker_pose
---
bool success
uint16 error_code
float32 final_position_error
float32 final_yaw_error
string message
---
string phase
float32 position_error
float32 yaw_error
