# MoveIt-side high-level place contract. The pose must carry its frame_id.
string object_id
geometry_msgs/PoseStamped place_pose
string slot_id
bool use_shelf_level
int32 shelf_level
bool use_nominal_lift_position
float64 nominal_lift_position
uint8 ARM_ONLY=7
uint8 ARM_WITH_LIFT=8
uint8 max_dof
string arm_name
string place_strategy
bool release_object
float32 timeout_sec
---
bool success
bool object_released
uint16 error_code
string message
---
string phase
float32 progress
