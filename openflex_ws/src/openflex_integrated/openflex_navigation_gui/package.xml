<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openflex_navigation_gui</name>
  <version>0.1.0</version>
  <description>Desktop workflow console for OpenFlex mapping, localization, navigation, and recording.</description>
  <maintainer email="openarmrobot@gmail.com">OpenArmX</maintainer>
  <license>CC-BY-NC-SA-4.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>controller_manager_msgs</depend>
  <depend>control_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>interface</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>openarmx_task_msgs</depend>
  <depend>openarmx_integrated_moveit_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>supermarket_scene_interfaces</depend>
  <exec_depend>supermarket_scene_web</exec_depend>
  <depend>tf2_ros</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>openarmx_integrated_bringup</exec_depend>
  <exec_depend>openarmx_task_executor</exec_depend>
  <exec_depend>openflex_grasp</exec_depend>
  <exec_depend>openflex_gui</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-pyqt5.qtwebengine</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbag2</exec_depend>
  <exec_depend>swerve_navigation</exec_depend>
  <exec_depend>pgo</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
