<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:macro name="openarmx_bimanual_ros2_control"
         params="arm_type
             left_can_interface:=^|can1
             right_can_interface:=^|can0
             use_fake_hardware:=^|false
             fake_sensor_commands:=^|false
             hand:=^|false
             left_arm_prefix:=^|left_
             right_arm_prefix:=^|right_
             can_fd:=^|false
             control_mode:=^|mit
             gripper_control_mode:=${control_mode}">

    <!-- Left Arm Hardware Interface -->
    <ros2_control name="openarmx_left_hardware_interface" type="system">
        <hardware>
          <param name="arm_type">${arm_type}</param>
          <xacro:if value="${use_fake_hardware}">
            <plugin>fake_components/GenericSystem</plugin>
            <param name="fake_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>
          <xacro:unless value="${use_fake_hardware}">
            <plugin>openarmx_hardware/OpenArmX_v10HW</plugin>
            <param name="can_interface">${left_can_interface}</param>
            <param name="arm_prefix">${left_arm_prefix}</param>
            <param name="hand">${hand}</param>
            <param name="can_fd">${can_fd}</param>
            <param name="control_mode">${control_mode}</param>
            <param name="gripper_control_mode">${gripper_control_mode}</param>
          </xacro:unless>
        </hardware>

      <xacro:macro name="configure_joint" params="joint_name initial_position min_position max_position">
        <joint name="${joint_name}">
          <command_interface name="position">
            <param name="min">${min_position}</param>
            <param name="max">${max_position}</param>
          </command_interface>
          <command_interface name="velocity"/>
          <command_interface name="effort"/>

          <state_interface name="position">
            <param name="initial_value">${initial_position}</param>
          </state_interface>

          <state_interface name="velocity">
            <param name="initial_value">0.0</param>
          </state_interface>

          <state_interface name="effort">
            <param name="initial_value">0.0</param>
          </state_interface>
        </joint>
      </xacro:macro>

      <xacro:configure_joint joint_name="openarmx_${left_arm_prefix}joint1" initial_position="0.0" min_position="-3.344396" max_position="0.905604"/>
      <xacro:configure_joint joint_name="openarmx_${left_arm_prefix}joint2" initial_position="0.0" min_position="-3.2707963267948967" max_position="0.1292036732051034"/>
      <xacro:configure_joint joint_name="openarmx_${left_arm_prefix}joint3" initial_position="0.0" min_position="-1.57" max_position="1.57"/>
      <xacro:configure_joint joint_name="openarmx_${left_arm_prefix}joint4" initial_position="0.0" min_position="0.0" max_position="1.8"/>
      <xacro:configure_joint joint_name="openarmx_${left_arm_prefix}joint5" initial_position="0.0" min_position="-1.5" max_position="1.5"/>
      <xacro:configure_joint joint_name="openarmx_${left_arm_prefix}joint6" initial_position="0.0" min_position="-0.75" max_position="0.75"/>
      <xacro:configure_joint joint_name="openarmx_${left_arm_prefix}joint7" initial_position="0.0" min_position="-1.4" max_position="1.4"/>

      <xacro:if value="${hand}">
        <xacro:configure_joint joint_name="openarmx_${left_arm_prefix}finger_joint1" initial_position="0.0" min_position="0.0" max_position="0.044" />
      </xacro:if>
    </ros2_control>

    <!-- Right Arm Hardware Interface -->
    <ros2_control name="openarmx_right_hardware_interface" type="system">
        <hardware>
          <param name="arm_type">${arm_type}</param>
          <xacro:if value="${use_fake_hardware}">
            <plugin>fake_components/GenericSystem</plugin>
            <param name="fake_sensor_commands">${fake_sensor_commands}</param>
            <param name="state_following_offset">0.0</param>
          </xacro:if>
          <xacro:unless value="${use_fake_hardware}">
            <plugin>openarmx_hardware/OpenArmX_v10HW</plugin>
            <param name="can_interface">${right_can_interface}</param>
            <param name="arm_prefix">${right_arm_prefix}</param>
            <param name="hand">${hand}</param>
            <param name="can_fd">${can_fd}</param>
            <param name="control_mode">${control_mode}</param>
            <param name="gripper_control_mode">${gripper_control_mode}</param>
          </xacro:unless>
        </hardware>

      <xacro:configure_joint joint_name="openarmx_${right_arm_prefix}joint1" initial_position="0.0" min_position="-1.25" max_position="3.0"/>
      <xacro:configure_joint joint_name="openarmx_${right_arm_prefix}joint2" initial_position="0.0" min_position="0.0" max_position="3.2"/>
      <xacro:configure_joint joint_name="openarmx_${right_arm_prefix}joint3" initial_position="0.0" min_position="-1.57" max_position="1.57"/>
      <xacro:configure_joint joint_name="openarmx_${right_arm_prefix}joint4" initial_position="0.0" min_position="0.0" max_position="1.8"/>
      <xacro:configure_joint joint_name="openarmx_${right_arm_prefix}joint5" initial_position="0.0" min_position="-1.5" max_position="1.5"/>
      <xacro:configure_joint joint_name="openarmx_${right_arm_prefix}joint6" initial_position="0.0" min_position="-0.75" max_position="0.75"/>
      <xacro:configure_joint joint_name="openarmx_${right_arm_prefix}joint7" initial_position="0.0" min_position="-1.4" max_position="1.4"/>

      <xacro:if value="${hand}">
        <xacro:configure_joint joint_name="openarmx_${right_arm_prefix}finger_joint1" initial_position="0.0" min_position="0.0" max_position="0.044" />
      </xacro:if>
    </ros2_control>

  </xacro:macro>

</robot>
