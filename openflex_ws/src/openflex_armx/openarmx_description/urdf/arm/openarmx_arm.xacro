<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="openarmx">

  <xacro:include filename="$(find openarmx_description)/urdf/arm/openarmx_macro.xacro" />

  <xacro:macro name="openarmx_arm" params="arm_type arm_prefix:='' no_prefix:=false description_pkg:='openarmx_description' connected_to:='base' xyz:='0 0 0' rpy:='0 0 0' joint_limits inertials kinematics kinematics_link kinematics_offset:=none poe_calibrated:=false " >

    <xacro:property name="prefix" value="${'' if no_prefix else 'openarmx' + '_' + arm_prefix}" />
    <xacro:property name="apply_right_poe_calibration" value="${poe_calibrated and arm_prefix == 'right_'}" />

    <xacro:if value="${arm_prefix == 'right_'}">
      <xacro:property name="reflect" value="1" />
    </xacro:if>

    <xacro:unless value="${arm_prefix == 'right_'}">
      <xacro:property name="reflect" value="-1" />
    </xacro:unless>

    <xacro:unless value="${connected_to == ''}">
      <joint name="${prefix}${connected_to}_joint" type="fixed">
        <parent link="${connected_to}"/>
        <child link="${prefix}link0"/>
        <origin rpy="${rpy}" xyz="${xyz}"/>
      </joint>
    </xacro:unless>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link0" kinematics_link="${kinematics_link}" inertials="${inertials}" reflect="${reflect}"/>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link1" kinematics_link="${kinematics_link}" inertials="${inertials}" reflect="${reflect}"/>

    <xacro:if value="${apply_right_poe_calibration}">
      <link name="${prefix}joint1_calibrated_axis_link"/>
      <joint name="${prefix}joint1" type="revolute">
        <origin xyz="-0.005942668844476215 0.02489259449310922 0.0005290342781101071" rpy="0.01507395916986142 0.02588606740808947 0.0003901914802350754"/>
        <parent link="${prefix}link0"/>
        <child link="${prefix}joint1_calibrated_axis_link"/>
        <axis xyz="0 0 1"/>
        <xacro:openarmx-limits name="joint1" config="${joint_limits}" offset="${-2.094396 if arm_prefix=='left_' else 0}"/>
      </joint>
      <joint name="${prefix}joint1_calibrated_frame" type="fixed">
        <origin xyz="0.004443436672342225 -0.02402377638438617 0.05797398134829122" rpy="-0.01506890862628857 -0.0258890073436396 0"/>
        <parent link="${prefix}joint1_calibrated_axis_link"/>
        <child link="${prefix}link1"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${apply_right_poe_calibration}">
      <joint name="${prefix}joint1" type="revolute">
        <xacro:openarmx-kinematics name="joint1" config="${kinematics}" reflect="${reflect}"/>
        <parent link="${prefix}link0" />
        <child link="${prefix}link1" />
        <axis xyz="0 0 1" />
        <xacro:openarmx-limits name="joint1" config="${joint_limits}" offset="${-2.094396 if arm_prefix=='left_' else 0}"/>
      </joint>
    </xacro:unless>

    <!-- for bimanual offset -->
    <xacro:link_with_sc no_prefix="${no_prefix}" name="link2" kinematics_link="${kinematics_link}" inertials="${inertials}" reflect="${reflect}"/>

    <xacro:property name="limit_offset_joint2" value="0" />

    <xacro:if value="${prefix.find('right_') != -1}">
      <xacro:property name="limit_offset_joint2" value="${pi/2}" />
    </xacro:if>
    
    <xacro:if value="${prefix.find('left_') != -1}">
      <xacro:property name="limit_offset_joint2" value="${-pi/2}" />
    </xacro:if>

    <!-- Keep right J2 away from the measured mechanical stops. -->
    <xacro:property name="joint2_lower_margin" value="0" />
    <xacro:property name="joint2_upper_margin" value="0" />
    <xacro:if value="${prefix.find('right_') != -1}">
      <xacro:property name="joint2_lower_margin" value="${1.7 - pi/2}" />
      <xacro:property name="joint2_upper_margin" value="${pi/2 + 1.7 - 3.2}" />
    </xacro:if>

    <xacro:if value="${apply_right_poe_calibration}">
      <link name="${prefix}joint2_calibrated_axis_link"/>
      <joint name="${prefix}joint2" type="revolute">
        <origin xyz="0.00269839320574249 0.01184605147871283 0.0777951542421699" rpy="-0.8212614227186312 -1.541685612054706 0.8210500759747352"/>
        <parent link="${prefix}link1"/>
        <child link="${prefix}joint2_calibrated_axis_link"/>
        <axis xyz="0 0 1"/>
        <xacro:openarmx-limits name="joint2" config="${joint_limits}" reflect="${reflect}" offset="${limit_offset_joint2}"
                              lower_margin="${joint2_lower_margin}" upper_margin="${joint2_upper_margin}"/>
      </joint>
      <joint name="${prefix}joint2_calibrated_frame" type="fixed">
        <origin xyz="0.002491008057606242 -0.01191164548477914 0.02325237622261254" rpy="1.592107815303833 1.550960241717171 0"/>
        <parent link="${prefix}joint2_calibrated_axis_link"/>
        <child link="${prefix}link2"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${apply_right_poe_calibration}">
      <joint name="${prefix}joint2" type="revolute">
        <xacro:openarmx-kinematics name="joint2" config="${kinematics}" offset="${kinematics_offset}" reflect="${reflect}"/>
        <parent link="${prefix}link1" />
        <child link="${prefix}link2" />
        <axis xyz="-1 0 0" />
        <xacro:openarmx-limits name="joint2" config="${joint_limits}" reflect="${reflect}" offset="${limit_offset_joint2}"
                              lower_margin="${joint2_lower_margin}" upper_margin="${joint2_upper_margin}"/>
      </joint>
    </xacro:unless>
    
    <xacro:link_with_sc no_prefix="${no_prefix}" name="link3" kinematics_link="${kinematics_link}" inertials="${inertials}" reflect="${reflect}"/>

    <xacro:if value="${apply_right_poe_calibration}">
      <link name="${prefix}joint3_calibrated_axis_link"/>
      <joint name="${prefix}joint3" type="revolute">
        <origin xyz="0.0200812960902003 -0.0008382328143086426 0.0008702333234907179" rpy="0.00626422397690309 0.01022220154005551 0.00006403388228711769"/>
        <parent link="${prefix}link2"/>
        <child link="${prefix}joint3_calibrated_axis_link"/>
        <axis xyz="0 0 1"/>
        <xacro:openarmx-limits name="joint3" config="${joint_limits}"/>
      </joint>
      <joint name="${prefix}joint3_calibrated_frame" type="fixed">
        <origin xyz="-0.001084322952663332 0.001452887070863967 0.09811663321876195" rpy="-0.006263896690427967 -0.01022240209152299 0"/>
        <parent link="${prefix}joint3_calibrated_axis_link"/>
        <child link="${prefix}link3"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${apply_right_poe_calibration}">
      <joint name="${prefix}joint3" type="revolute">
        <xacro:openarmx-kinematics name="joint3" config="${kinematics}" />
        <parent link="${prefix}link2" />
        <child link="${prefix}link3" />
        <axis xyz="0 0 1" />
        <xacro:openarmx-limits name="joint3" config="${joint_limits}" />
      </joint>
    </xacro:unless>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link4" kinematics_link="${kinematics_link}" />

    <xacro:if value="${apply_right_poe_calibration}">
      <link name="${prefix}joint4_calibrated_axis_link"/>
      <joint name="${prefix}joint4" type="revolute">
        <origin xyz="0.00191989810280969 -0.1400399445721474 0.1307521293751615" rpy="-1.56640469447385 0.00009500518593578819 -0.02162971574640385"/>
        <parent link="${prefix}link3"/>
        <child link="${prefix}joint4_calibrated_axis_link"/>
        <axis xyz="0 0 1"/>
        <xacro:openarmx-limits name="joint4" config="${joint_limits}"/>
      </joint>
      <joint name="${prefix}joint4_calibrated_frame" type="fixed">
        <origin xyz="-0.005619799719490383 -0.01030643727891906 0.1710073229900723" rpy="1.566403666966206 -0.0216299243606619 0"/>
        <parent link="${prefix}joint4_calibrated_axis_link"/>
        <child link="${prefix}link4"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${apply_right_poe_calibration}">
      <joint name="${prefix}joint4" type="revolute">
        <xacro:openarmx-kinematics name="joint4" config="${kinematics}" />
        <parent link="${prefix}link3" />
        <child link="${prefix}link4" />
        <axis xyz="0 1 0" />
        <xacro:openarmx-limits name="joint4" config="${joint_limits}" />
      </joint>
    </xacro:unless>

    <link name="${prefix}link4_ext"/>
    <joint name="${prefix}joint4_ext" type="fixed">
      <origin rpy="0.0 0.0 0.0" xyz="0.0 ${-0.065 if reflect == -1 else 0.0} 0.0"/>
      <parent link="${prefix}link4"/>
      <child link="${prefix}link4_ext"/>
    </joint>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link5" kinematics_link="${kinematics_link}" inertials="${inertials}" reflect="${reflect}" />

    <xacro:if value="${apply_right_poe_calibration}">
      <link name="${prefix}joint5_calibrated_axis_link"/>
      <joint name="${prefix}joint5" type="revolute">
        <origin xyz="0.007573221956119573 -0.02786136395275865 -0.2396086132691086" rpy="0.007429760955754065 -0.02049692705740662 -0.0001522794061742723"/>
        <parent link="${prefix}link4"/>
        <child link="${prefix}joint5_calibrated_axis_link"/>
        <axis xyz="0 0 1"/>
        <xacro:openarmx-limits name="joint5" config="${joint_limits}"/>
      </joint>
      <joint name="${prefix}joint5_calibrated_frame" type="fixed">
        <origin xyz="-0.0000778400891625862 -0.0003227631897611827 0.3656995144394216" rpy="-0.007428200271170226 0.02049749264097149 0"/>
        <parent link="${prefix}joint5_calibrated_axis_link"/>
        <child link="${prefix}link5"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${apply_right_poe_calibration}">
      <joint name="${prefix}joint5" type="revolute">
        <xacro:openarmx-kinematics name="joint5" config="${kinematics}" />
        <parent link="${prefix}link4" />
        <child link="${prefix}link5" />
        <axis xyz="0 0 1" />
        <xacro:openarmx-limits name="joint5" config="${joint_limits}" />
      </joint>
    </xacro:unless>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link6" kinematics_link="${kinematics_link}" inertials="${inertials}" reflect="${reflect}"/>

    <xacro:if value="${apply_right_poe_calibration}">
      <link name="${prefix}joint6_calibrated_axis_link"/>
      <joint name="${prefix}joint6" type="revolute">
        <origin xyz="0.0006129201529013823 -0.0006581914344783724 0.1255570102401349" rpy="-1.571827652818441 -0.3530729922765616 -1.567813751821935"/>
        <parent link="${prefix}link5"/>
        <child link="${prefix}joint6_calibrated_axis_link"/>
        <axis xyz="0 0 1"/>
        <xacro:openarmx-limits name="joint6" config="${joint_limits}"/>
      </joint>
      <joint name="${prefix}joint6_calibrated_frame" type="fixed">
        <origin xyz="0.001367529451474142 -0.005334826021968553 0.03680939684148538" rpy="1.923870762203432 -1.567997733777094 0"/>
        <parent link="${prefix}joint6_calibrated_axis_link"/>
        <child link="${prefix}link6"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${apply_right_poe_calibration}">
      <joint name="${prefix}joint6" type="revolute">
        <xacro:openarmx-kinematics name="joint6" config="${kinematics}" />
        <parent link="${prefix}link5" />
        <child link="${prefix}link6" />
        <axis xyz="1 0 0" />
        <xacro:openarmx-limits name="joint6" config="${joint_limits}" />
      </joint>
    </xacro:unless>

    <xacro:link_with_sc no_prefix="${no_prefix}" name="link7" kinematics_link="${kinematics_link}" inertials="${inertials}" reflect="${reflect}"/>

    <xacro:if value="${apply_right_poe_calibration}">
      <link name="${prefix}joint7_calibrated_axis_link"/>
      <joint name="${prefix}joint7" type="revolute">
        <origin xyz="-0.03262060985599859 -0.118213618575493 -0.002543821092015341" rpy="-1.612883131938537 0.0003062284065107097 0.007271689490216154"/>
        <parent link="${prefix}link6"/>
        <child link="${prefix}joint7_calibrated_axis_link"/>
        <axis xyz="0 0 1"/>
        <xacro:openarmx-limits name="joint7" config="${joint_limits}"/>
      </joint>
      <joint name="${prefix}joint7_calibrated_frame" type="fixed">
        <origin xyz="-0.004020434789340542 -0.007515464763451385 0.1180342873241996" rpy="1.612884245342395 0.007278134529272736 0"/>
        <parent link="${prefix}joint7_calibrated_axis_link"/>
        <child link="${prefix}link7"/>
      </joint>
    </xacro:if>
    <xacro:unless value="${apply_right_poe_calibration}">
      <joint name="${prefix}joint7" type="revolute">
        <xacro:openarmx-kinematics name="joint7" config="${kinematics}" />
        <parent link="${prefix}link6"/>
        <child link="${prefix}link7"/>
        <axis xyz="0 ${reflect} 0"/>
        <xacro:openarmx-limits name="joint7" config="${joint_limits}" />
      </joint>
    </xacro:unless>

    <link name="${prefix}link7_pico"/>
    <joint name="${prefix}link7_pico_joint" type="fixed">
      <origin rpy="0 3.1416 4.7124" xyz="0 0 0"/>
      <parent link="${prefix}link7"/>
      <child link="${prefix}link7_pico"/>
    </joint>

    <!-- <link name="${prefix}link8"/>

    <joint name="${prefix}joint8" type="fixed">
      <xacro:openarmx-kinematics name="joint8" config="${kinematics}" />
      <parent link="${prefix}link7" />
      <child link="${prefix}link8" />
    </joint> -->

  </xacro:macro>
</robot>
