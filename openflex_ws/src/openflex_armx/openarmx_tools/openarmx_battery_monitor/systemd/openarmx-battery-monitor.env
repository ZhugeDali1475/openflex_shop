ROS_SETUP=/opt/ros/humble/setup.bash
WS_SETUP=@OPENFLEX_WS_SETUP@

SERIAL_PORT=/dev/ttyACM0
SERIAL_PORT_CANDIDATES=/dev/ttyACM0,/dev/ttyUSB0,/dev/ttyACM1,/dev/ttyUSB1,/dev/ttyACM2,/dev/ttyUSB2,/dev/ttyACM3,/dev/ttyUSB3
SLAVE_ID=3

POLL_HZ=5.0
TIMEOUT_SEC=0.2
READ_RETRIES=0
OFFLINE_AFTER_FAILURES=1
BATTERY_STATE_TOPIC=/battery_state
