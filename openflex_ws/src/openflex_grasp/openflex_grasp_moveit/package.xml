<?xml version="1.0"?>
<package format="3">
  <name>openflex_grasp_moveit</name>
  <version>0.1.0</version>
  <description>MoveIt Cartesian action server used by the portable OpenFlex grasp stack.</description>
  <maintainer email="openarmrobot@gmail.com">openflex</maintainer>
  <license>CC-BY-NC-SA-4.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>openarmx_integrated_moveit_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>shape_msgs</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>openarmx_integrated_description</exec_depend>
  <exec_depend>openarmx_integrated_moveit_config</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
