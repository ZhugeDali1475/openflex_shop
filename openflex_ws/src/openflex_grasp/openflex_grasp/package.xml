<?xml version="1.0"?>
<package format="3">
  <name>openflex_grasp</name>
  <version>0.1.0</version>
  <description>Portable OpenFlex product perception, GraspNetBaseline fitting, and grasp execution.</description>
  <maintainer email="openarmrobot@gmail.com">openflex</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>action_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>control_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>openarmx_integrated_moveit_msgs</depend>
  <depend>openarmx_task_msgs</depend>
  <depend>openflex_grasp_interfaces</depend>
  <depend>message_filters</depend>
  <depend>cv_bridge</depend>
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>openarmx_integrated_moveit_config</exec_depend>
  <exec_depend>openflex_grasp_moveit</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
